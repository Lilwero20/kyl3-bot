# === Discord bot ===
# Token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Bot owner ID(s), comma separated (allows /eval etc.)
OWNER_IDS=

# Global prefix for legacy (message) commands
PREFIX=!

# Enable/disable legacy prefix commands (in addition to slash commands)
ENABLE_PREFIX=true

# Set to a guild ID to register slash commands only in one server (faster dev)
# Leave empty to register globally
DEV_GUILD_ID=

# Data storage directory (JSON store)
DATA_DIR=./data

# Set to true ONLY after enabling "Privileged Gateway Intents"
# (Server Members, Presence, Message Content) in the Discord developer portal.
# Leave false if they are not enabled yet — the bot still runs, but features
# like welcome/autorole/auto-mod filters and prefix commands stay disabled.
ENABLE_PRIVILEGED_INTENTS=false
